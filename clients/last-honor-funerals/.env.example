# Copy this file to `.env` in the same folder, then fill values in as they
# become available.  `.env` is git-ignored and must never be committed.
# The prototype runs fine with everything left as it is below and makes NO
# external calls.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "mock" = built-in rule-based provider: free, offline, deterministic.
# There is no live model adapter in this build. Setting anything else (or
# ENABLE_LIVE_AI=true) makes the program stop with a clear message instead of
# silently pretending an AI is connected.
AI_PROVIDER=mock
ENABLE_LIVE_AI=false

# Only relevant once a live provider is added and you approve API spending.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Messaging
# ---------------------------------------------------------------------------
# console = print replies in the terminal (safe default)
# file    = write replies to data/runtime/outbox.jsonl
# whatsapp = not built yet; choosing it stops with an explanation
MESSAGE_TRANSPORT=console

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Phase 6 - leave blank for now)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Staff alerts
# ---------------------------------------------------------------------------
# When set, notify_staff reports "not delivered" because no email integration
# exists yet - it never pretends an email went out.
STAFF_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Payment reminders - MUST stay false until the owner approves everything
# ---------------------------------------------------------------------------
PAYMENT_REMINDERS_ENABLED=false

# ---------------------------------------------------------------------------
# Paths (relative paths are resolved from the project folder)
# ---------------------------------------------------------------------------
LH_DATA_DIR=data/runtime
LH_BUSINESS_PROFILE=data/business_profile.json
